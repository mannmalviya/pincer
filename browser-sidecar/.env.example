# Browser sidecar configuration.
# Copy this file to .env (same directory) and fill in real values.

# NVIDIA NIM API key from https://build.nvidia.com/ → top-right menu → API keys.
# Used by browser-use's LLM driver (Nemotron via OpenAI-compatible endpoint).
NIM_API_KEY=

# OpenAI-compatible base URL. Default is NVIDIA's hosted endpoint; override
# only if you're pointing at a different OpenAI-compatible host (e.g. a
# local Ollama proxy for fallback).
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model ID as NIM advertises it. Default is the multimodal Nano-Omni variant
# — we use vision (screenshots) to keep per-step prompts small and fast.
# Open https://build.nvidia.com/ and copy the exact "model:" string from the
# model card if NIM responds with a "model not found" error.
NIM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
