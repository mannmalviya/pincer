# Python virtual environment — managed locally by uv, not committed.
.venv/

# Byte-compiled artifacts
__pycache__/
*.py[cod]
*$py.class

# uv / pip caches
.uv-cache/

# Secrets — NIM API key, etc. Never commit.
.env

# Persistent Chromium profile (cookies, localStorage from manual login).
# Contains your real session tokens — never commit.
profile/
