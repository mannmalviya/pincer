# Pincer agent runtime config. Copy to .env and fill in real values.
#
#   cp .env.example .env
#   vi .env   # paste your NIM key, optionally pick models
#
# The agent loads this at startup via dotenv (see src/index.ts). Both `npm
# run dev` and `npm start` pick it up. Missing keys default to the values
# below; `process.env` always wins, so PM2- or shell-set vars still
# override the file.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Port the Fastify server binds to. 8000 unless something else is using it.
PORT=8000
# Bind interface. Use 0.0.0.0 in production so Brev's port routing can
# reach the agent; 127.0.0.1 is safer on a dev laptop.
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Where the SQLite database file lives. Relative paths resolve against the
# process's CWD; use an absolute path in production.
DB_PATH=/home/ubuntu/.pincer/agent.sqlite

# ---------------------------------------------------------------------------
# Watch loop
# ---------------------------------------------------------------------------
# Default scheduler period in milliseconds. The settings table overrides
# this at runtime; this value applies until the user changes it via the
# dashboard's Settings page.
WATCH_INTERVAL_MS=60000

# User-Agent string sent on every outbound Reddit/HN request. Reddit
# rate-limits generic UAs aggressively; use something identifiable.
USER_AGENT=pincer-agent/0.1 (+https://github.com/mannmalviya/pincer)

# ---------------------------------------------------------------------------
# NVIDIA NIM (Nemotron via integrate.api.nvidia.com)
# ---------------------------------------------------------------------------
# REQUIRED for reply drafting and onboarding repo analysis. Without it,
# /comments/:id/draft-reply and /onboarding/analyze return 503.
NIM_API_KEY=nvapi-REPLACE_ME

# Base URL for the NIM gateway. Only change if NVIDIA migrates the API.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model used by the legacy single-model reply path. The orchestrator (below)
# can route around this; kept for back-compat.
NIM_REPLY_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# LLM-orchestrator routing. Set distinct primary + fast model IDs to enable
# automatic routing on each call. If primary == fast, the orchestrator
# short-circuits (zero overhead).
NIM_PRIMARY_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NIM_FAST_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
NIM_ORCHESTRATOR_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
